{
  "name": "project-scaffold-vscode",
  "displayName": "ProjectScaffold",
  "description": "Software architecture editor for *.scaffold.yaml files: modules, ports, typed interfaces and links",
  "version": "1.0.0",
  "publisher": "mblet",
  "author": "Mickaël Blet",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MickaelBlet/ProjectScaffold"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json",
    "workspaceContains:**/*.scaffold.{yaml,yml,json}",
    "onWebviewPanel:projectScaffold.preview"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**/*.js",
    "media/**",
    "resources/**",
    "LICENSE"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectScaffold",
          "title": "ProjectScaffold",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "projectScaffold": [
        {
          "type": "webview",
          "id": "projectScaffold.panel",
          "name": "ProjectScaffold"
        }
      ]
    },
    "commands": [
      {
        "command": "projectScaffold.showPreview",
        "title": "Open Preview",
        "category": "ProjectScaffold",
        "icon": "$(open-preview)"
      },
      {
        "command": "projectScaffold.showSource",
        "title": "Show Source",
        "category": "ProjectScaffold",
        "icon": "$(go-to-file)"
      },
      {
        "command": "projectScaffold.layoutFull",
        "title": "Switch to Full Layout",
        "category": "ProjectScaffold",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "projectScaffold.layoutIntegrated",
        "title": "Switch to Integrated Layout",
        "category": "ProjectScaffold",
        "icon": "$(layout-sidebar-left-off)"
      },
      {
        "command": "projectScaffold.addModule",
        "title": "Add Module",
        "category": "ProjectScaffold",
        "icon": "$(add)"
      },
      {
        "command": "projectScaffold.arrange",
        "title": "Auto-arrange",
        "category": "ProjectScaffold",
        "icon": "$(layout)"
      },
      {
        "command": "projectScaffold.exportPng",
        "title": "Export Diagram as PNG…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.exportSvg",
        "title": "Export Diagram as SVG…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.importSettings",
        "title": "Import Settings…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.exportSettings",
        "title": "Export Settings…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.generate",
        "title": "Generate Code",
        "category": "ProjectScaffold",
        "icon": "$(file-code)"
      },
      {
        "command": "projectScaffold.generateInto",
        "title": "Generate Code Into…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.codeTemplates",
        "title": "Code Templates…",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.generationPanel",
        "title": "Show Code Generation Panel",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.search",
        "title": "Show Search Panel",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.problems",
        "title": "Show Problems Panel",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.output",
        "title": "Show Output Panel",
        "category": "ProjectScaffold"
      },
      {
        "command": "projectScaffold.noop",
        "title": "Handled by the diagram",
        "category": "ProjectScaffold"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "projectScaffold.showPreview",
          "when": "resourceExtname =~ /^\\.(ya?ml|json)$/ && !projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.showSource",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.layoutFull",
          "when": "projectScaffold.diagramActive && projectScaffold.layout != 'full'"
        },
        {
          "command": "projectScaffold.layoutIntegrated",
          "when": "projectScaffold.diagramActive && projectScaffold.layout == 'full'"
        },
        {
          "command": "projectScaffold.addModule",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.arrange",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.exportPng",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.exportSvg",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.importSettings",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.exportSettings",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.generate",
          "when": "projectScaffold.diagramActive || resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/"
        },
        {
          "command": "projectScaffold.generateInto",
          "when": "projectScaffold.diagramActive || resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/"
        },
        {
          "command": "projectScaffold.codeTemplates",
          "when": "projectScaffold.diagramActive || resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/"
        },
        {
          "command": "projectScaffold.generationPanel",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.search",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.problems",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.output",
          "when": "projectScaffold.diagramActive"
        },
        {
          "command": "projectScaffold.noop",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "projectScaffold.showPreview",
          "when": "resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/ && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation"
        },
        {
          "command": "projectScaffold.generate",
          "when": "resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/ && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation"
        },
        {
          "command": "projectScaffold.showSource",
          "when": "projectScaffold.diagramActive",
          "group": "navigation@1"
        },
        {
          "command": "projectScaffold.layoutFull",
          "when": "projectScaffold.diagramActive && projectScaffold.layout != 'full'",
          "group": "navigation@2"
        },
        {
          "command": "projectScaffold.layoutIntegrated",
          "when": "projectScaffold.diagramActive && projectScaffold.layout == 'full'",
          "group": "navigation@2"
        },
        {
          "command": "projectScaffold.exportPng",
          "when": "projectScaffold.diagramActive",
          "group": "export"
        },
        {
          "command": "projectScaffold.exportSvg",
          "when": "projectScaffold.diagramActive",
          "group": "export"
        },
        {
          "command": "projectScaffold.generate",
          "when": "projectScaffold.diagramActive",
          "group": "navigation@4"
        },
        {
          "command": "projectScaffold.generateInto",
          "when": "projectScaffold.diagramActive",
          "group": "generate"
        },
        {
          "command": "projectScaffold.codeTemplates",
          "when": "projectScaffold.diagramActive",
          "group": "generate"
        }
      ],
      "explorer/context": [
        {
          "command": "projectScaffold.showPreview",
          "when": "resourceExtname =~ /^\\.(ya?ml|json)$/",
          "group": "navigation"
        },
        {
          "command": "projectScaffold.generate",
          "when": "resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "command": "projectScaffold.showPreview",
        "when": "editorTextFocus && resourceFilename =~ /\\.scaffold\\.(ya?ml|json)$/"
      },
      {
        "key": "ctrl+e",
        "mac": "cmd+e",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+d",
        "mac": "cmd+d",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+a",
        "mac": "cmd+a",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+m",
        "mac": "cmd+m",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+p",
        "mac": "cmd+p",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+0",
        "mac": "cmd+0",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+g",
        "mac": "cmd+g",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+l",
        "mac": "cmd+l",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+i",
        "mac": "cmd+i",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+,",
        "mac": "cmd+,",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+left",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+right",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+enter",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+g",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+i",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+m",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+o",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+u",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "alt+z",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "f1",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      },
      {
        "key": "f2",
        "command": "projectScaffold.noop",
        "when": "projectScaffold.focused"
      }
    ],
    "configuration": {
      "title": "ProjectScaffold",
      "properties": {
        "projectScaffold.syncSelection": {
          "type": "boolean",
          "default": true,
          "description": "Move the text cursor to the entity selected in the diagram, and select in the diagram the entity under the text cursor."
        },
        "projectScaffold.views.revealOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Show the ProjectScaffold side bar when a project file is first opened in the window."
        },
        "projectScaffold.preview.layout": {
          "type": "string",
          "enum": [
            "integrated",
            "full"
          ],
          "enumDescriptions": [
            "Explorer and Code generation in the ProjectScaffold side bar, the Inspector and Settings in the preview",
            "Every tool docked in the preview, like the web app; templates and generated files open in its tabs"
          ],
          "default": "integrated",
          "markdownDescription": "Layout of the diagram preview. _Switch to Full Layout_ / _Switch to Integrated Layout_ (editor title bar, toolbar of the diagram) change it for every preview."
        },
        "projectScaffold.preview.position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "Left of the text",
            "Right of the text"
          ],
          "default": "left",
          "description": "Where Open Preview to the Side places the diagram."
        },
        "projectScaffold.preview.showSideBar": {
          "type": "boolean",
          "default": true,
          "description": "Opening a preview shows the ProjectScaffold side bar (Explorer, Code generation), in the integrated layout."
        },
        "projectScaffold.generate.outputDir": {
          "type": "string",
          "default": "generated/${project}",
          "markdownDescription": "Directory of the code generated from a project file (_Generate Code_), relative to the file; `${project}` is the project's namespace. _Generate Code Into…_ picks another one, remembered for the file in the workspace."
        },
        "projectScaffold.generate.templates": {
          "type": "string",
          "default": "",
          "markdownDescription": "Template folder of the code generated from a project file, relative to the file (a `manifest.yaml` and its templates); empty: the output directory's `.scaffold/templates`, else the project's built-in template set (`generation.templates`, default `cpp17`). _Code Templates…_ picks another one, remembered for the file in the workspace."
        }
      }
    }
  }
}
