{% assign l = connection.link %}
{% assign k = l.constraints %}
    // {{ l.name }}: {{ l.from.module }}:{{ l.from.port }} -> {{ l.to.module }}:{{ l.to.port }}, {{ k.direction }}, {{ k.performance.class }}{% if k.performance.maxLatencyMs %}, max {{ k.performance.maxLatencyMs }} ms{% endif %}{% if k.performance.rateHz %}, {{ k.performance.rateHz }} Hz{% endif %}{% if k.ack.required %}, ack{% if k.ack.timeoutMs %} within {{ k.ack.timeoutMs }} ms{% endif %}{% endif %}
{{ l.description | doc_comment: '    // ' }}
{% if k.remote.enabled %}
    {% user 'link.' | append: l.name %}
    // Remote over {{ k.remote.transport | default: 'an unset transport' }}: replace with a proxy of that transport.
    {{ connection.from | cpp_endpoint }}.connect({{ connection.to | cpp_endpoint }});
    {% enduser %}
{% else %}
    {{ connection.from | cpp_endpoint }}.connect({{ connection.to | cpp_endpoint }});
{% endif %}
