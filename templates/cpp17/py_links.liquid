"""Links between the binaries of {{ project.name }}. The address of a link is the value of its environment
variable, else its default (as in C++)."""
from __future__ import annotations

import os
from typing import List, NamedTuple


class Link(NamedTuple):
    name: str
    index: int
    interface: str
    transport: str
    variable: str
    default: str
    # Every call waits for its reply.
    ack: bool
    # Seconds to wait for a reply.
    timeout: float
    # Binary calling through a proxy.
    caller: str
    # Binary receiving the calls through a stub.
    callee: str

    @property
    def address(self) -> str:
        return os.environ.get(self.variable) or self.default

