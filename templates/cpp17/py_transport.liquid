"""Transports of the calls between binaries: tcp, udp, http, websocket and shm, as
src/remote/transport.cpp (standard library only; shm: POSIX)."""
from __future__ import annotations

import base64
import hashlib
import logging
import os
import select
import socket
import struct
import sys
import threading
import time
from typing import Callable, List, Optional, Tuple

from .wire import CALL, ERROR, HEADER, MAX_LENGTH, REPLY, WANT_REPLY, Reader, RemoteError, Writer, error_frame, frame, header, payload

Handler = Callable[[bytes], Optional[bytes]]
"""Answers a call frame: the reply frame, or None when the call wants none."""

TRANSPORTS = ('tcp', 'udp', 'http', 'websocket', 'shm')
MAX_DATAGRAM = 65507

_log = logging.getLogger(__name__)


def address(variable: str, fallback: str) -> str:
    """The value of environment variable `variable`, else `fallback`."""
    return os.environ.get(variable) or fallback


def _split(address: str) -> Tuple[str, int]:
    host, sep, port = address.rpartition(':')
    if not sep:
        raise RemoteError(f"address '{address}' is not host:port")
    return host.strip('[]'), int(port)


def _left(deadline: Optional[float]) -> Optional[float]:
    return None if deadline is None else max(0.0, deadline - time.monotonic())


def _await(sock: socket.socket, deadline: Optional[float], stop: Optional[threading.Event]) -> bool:
    """Waits until `sock` has input: False at `deadline` (None: never), or when `stop` is set."""
    while True:
        if stop is not None and stop.is_set():
            return False
        left = _left(deadline)
        if left == 0.0:
            return False
        ready, _, _ = select.select([sock], [], [], min(0.1, left) if left is not None else 0.1)
        if ready:
            return True


class _Closed(RemoteError):
    def __init__(self) -> None:
        super().__init__('connection closed')


class _Input:
    """Buffered input of a stream socket."""

    def __init__(self, sock: socket.socket) -> None:
        self._sock = sock
        self._data = b''

    def _fill(self, deadline: Optional[float], stop: Optional[threading.Event]) -> bool:
        if not _await(self._sock, deadline, stop):
            return False
        chunk = self._sock.recv(65536)
        if not chunk:
            raise _Closed()
        self._data += chunk
        return True

    def take(self, size: int, deadline: Optional[float], stop: Optional[threading.Event] = None) -> Optional[bytes]:
        """The next `size` bytes: None at `deadline` or on `stop`."""
        while len(self._data) < size:
            if not self._fill(deadline, stop):
                return None
        out, self._data = self._data[:size], self._data[size:]
        return out

    def until(self, delimiter: bytes, limit: int, deadline: Optional[float],
              stop: Optional[threading.Event] = None) -> Optional[bytes]:
        """The bytes up to `delimiter` included, at most `limit` of them."""
        while delimiter not in self._data:
            if len(self._data) > limit:
                raise RemoteError('header too long')
            if not self._fill(deadline, stop):
                return None
        return self.take(self._data.index(delimiter) + len(delimiter), deadline, stop)


def _read_frame(stream: _Input, deadline: Optional[float], stop: Optional[threading.Event] = None) -> Optional[bytes]:
    head = stream.take(HEADER.size, deadline, stop)
    if head is None:
        return None
    body = stream.take(header(head)[4], deadline, stop)
    return None if body is None else head + body


def _header_value(head: bytes, name: str) -> Optional[str]:
    """Value of header `name` (lower case) in an HTTP head."""
    for line in head.decode('latin-1').split('\r\n')[1:]:
        key, sep, value = line.partition(':')
        if sep and key.strip().lower() == name:
            return value.strip()
    return None


def _content_length(head: bytes) -> int:
    value = _header_value(head, 'content-length')
    n = int(value) if value and value.isdigit() else 0
    if n > HEADER.size + MAX_LENGTH:
        raise RemoteError('bad Content-Length')
    return n


def _accept_key(key: str) -> str:
    digest = hashlib.sha1((key + '258EAFA5-E914-47DA-95CA-C5AB0DC85B11').encode()).digest()
    return base64.b64encode(digest).decode()


_CONTINUATION, _TEXT, _BINARY, _CLOSE, _PING, _PONG = 0x0, 0x1, 0x2, 0x8, 0x9, 0xA


def _ws_frame(opcode: int, data: bytes, mask: bool) -> bytes:
    """A WebSocket frame; clients mask theirs."""
    size = len(data)
    bit = 0x80 if mask else 0
    if size < 126:
        head = bytes([0x80 | opcode, bit | size])
    elif size <= 0xFFFF:
        head = bytes([0x80 | opcode, bit | 126]) + struct.pack('>H', size)
    else:
        head = bytes([0x80 | opcode, bit | 127]) + struct.pack('>Q', size)
    if not mask:
        return head + data
    key = os.urandom(4)
    return head + key + bytes(b ^ key[i % 4] for i, b in enumerate(data))


def _ws_read(sock: socket.socket, stream: _Input, mask: bool, deadline: Optional[float],
             stop: Optional[threading.Event] = None) -> Optional[bytes]:
    """The next WebSocket message (fragments joined), answering pings: None at `deadline` or on
    `stop`; raises _Closed on a close frame."""
    message = b''
    while True:
        head = stream.take(2, deadline, stop)
        if head is None:
            return None
        size = head[1] & 0x7F
        if size >= 126:
            more = stream.take(2 if size == 126 else 8, deadline, stop)
            if more is None:
                return None
            size = int.from_bytes(more, 'big')
        if size > HEADER.size + MAX_LENGTH:
            raise RemoteError('WebSocket message too large')
        key = b''
        if head[1] & 0x80:
            key = stream.take(4, deadline, stop)
            if key is None:
                return None
        data = stream.take(size, deadline, stop)
        if data is None:
            return None
        if key:
            data = bytes(b ^ key[i % 4] for i, b in enumerate(data))
        opcode = head[0] & 0x0F
        if opcode == _CLOSE:
            raise _Closed()
        if opcode == _PING:
            sock.sendall(_ws_frame(_PONG, data, mask))
        elif opcode in (_CONTINUATION, _TEXT, _BINARY):
            message += data
            if head[0] & 0x80:
                return message
        elif opcode != _PONG:
            raise RemoteError('bad WebSocket opcode')


# Shared memory: a header, then two rings (calls, replies) of messages (u32 length + bytes), each
# with its head (bytes written) and tail (bytes read) counters.

SHM_MAGIC = 0x314D4353  # "SCM1"
RING_CAPACITY = 1 << 20
RING_HEADER = 64
_U32 = struct.Struct('<I')


def _shm_size(capacity: int) -> int:
    return RING_HEADER + 2 * (RING_HEADER + capacity)


def _shm_name(address: str) -> str:
    return address.lstrip('/')


_created = set()  # names of the segments made by this process


def _shm_open(name: str, create: bool = False, size: int = 0):
    """Shared memory `name`, not unlinked by the resource tracker at exit unless created here."""
    from multiprocessing import shared_memory

    if create:
        _created.add(name)
    if sys.version_info >= (3, 13):
        return shared_memory.SharedMemory(name, create=create, size=size, track=create)
    shm = shared_memory.SharedMemory(name, create=create, size=size)
    if name not in _created:
        try:
            from multiprocessing import resource_tracker

            resource_tracker.unregister(shm._name, 'shared_memory')  # type: ignore[attr-defined]
        except Exception:  # noqa: BLE001
            pass
    return shm


def _shm_unlink(name: str) -> None:
    try:
        import _posixshmem  # type: ignore[import-not-found]

        _posixshmem.shm_unlink('/' + name)
    except (ImportError, OSError):
        pass


class _Ring:
    """One ring, written by one process and read by another."""

    def __init__(self, buf: memoryview, base: int, capacity: int) -> None:
        self._buf = buf
        self._base = base
        self._data = base + RING_HEADER
        self._capacity = capacity

    def _load(self, offset: int) -> int:
        return _U32.unpack_from(self._buf, self._base + offset)[0]

    def _copy_in(self, at: int, data: bytes) -> None:
        offset = at % self._capacity
        first = min(len(data), self._capacity - offset)
        self._buf[self._data + offset:self._data + offset + first] = data[:first]
        self._buf[self._data:self._data + len(data) - first] = data[first:]

    def _copy_out(self, at: int, size: int) -> bytes:
        offset = at % self._capacity
        first = min(size, self._capacity - offset)
        return bytes(self._buf[self._data + offset:self._data + offset + first]) + bytes(
            self._buf[self._data:self._data + size - first])

    def push(self, message: bytes) -> bool:
        """Writes a message: False when there is no room for it yet."""
        if len(message) + 4 > self._capacity:
            raise RemoteError('frame larger than the shared memory ring')
        head, tail = self._load(0), self._load(4)
        if self._capacity - ((head - tail) & 0xFFFFFFFF) < len(message) + 4:
            return False
        self._copy_in(head, _U32.pack(len(message)) + message)
        _U32.pack_into(self._buf, self._base, (head + 4 + len(message)) & 0xFFFFFFFF)
        return True

    def pop(self) -> Optional[bytes]:
        """Reads a message: None when there is none."""
        tail, head = self._load(4), self._load(0)
        used = (head - tail) & 0xFFFFFFFF
        if used < 4:
            return None
        size = _U32.unpack(self._copy_out(tail, 4))[0]
        if size > self._capacity or used < 4 + size:
            raise RemoteError('corrupt shared memory ring')
        message = self._copy_out(tail + 4, size)
        _U32.pack_into(self._buf, self._base + 4, (tail + 4 + size) & 0xFFFFFFFF)
        return message


def _rings(buf: memoryview) -> Tuple[_Ring, _Ring]:
    capacity = _U32.unpack_from(buf, 4)[0]
    return _Ring(buf, RING_HEADER, capacity), _Ring(buf, RING_HEADER + RING_HEADER + capacity, capacity)


def _wait_for(ready: Callable[[], object], deadline: Optional[float], stop: Optional[threading.Event] = None) -> object:
    """Calls `ready` until it gives a value (returned), `deadline` or `stop` (None), pausing longer each time."""
    pause = 0.0
    while True:
        value = ready()
        if value:
            return value
        if (stop is not None and stop.is_set()) or _left(deadline) == 0.0:
            return None
        time.sleep(pause)
        pause = min(pause + 0.00005, 0.001)


# Clients.


class Channel:
    """Client end of a link: sends call frames, receives their replies; connects on the first call,
    and again on the next call after a failure."""

    def exchange(self, data: bytes, wait: bool, timeout: float) -> Optional[bytes]:
        """Sends frame `data`; when `wait`, returns the reply frame of the same call id, received
        within `timeout` seconds."""
        deadline = time.monotonic() + timeout
        try:
            self._open(deadline)
            self._send(data, deadline)
            if not wait:
                return None
            call_id = header(data)[3]
            while True:
                reply = self._receive(deadline)
                if reply is None:
                    raise RemoteError(f'no reply within {timeout * 1000:.0f} ms')
                # Replies of calls given up on are skipped.
                if header(reply)[3] == call_id:
                    return reply
        except OSError as e:
            self._drop()
            raise RemoteError(str(e)) from e
        except BaseException:
            self._drop()
            raise

    def close(self) -> None:
        self._drop()

    def _open(self, deadline: float) -> None:
        pass

    def _send(self, data: bytes, deadline: float) -> None:
        raise NotImplementedError

    def _receive(self, deadline: float) -> Optional[bytes]:
        raise NotImplementedError

    def _drop(self) -> None:
        pass


class _StreamChannel(Channel):
    def __init__(self, address: str) -> None:
        self._address = address
        self._sock: Optional[socket.socket] = None
        self._input: Optional[_Input] = None

    def _connect(self, deadline: float) -> socket.socket:
        sock = socket.create_connection(_split(self._address), timeout=_left(deadline) or 0.001)
        sock.settimeout(None)
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        return sock

    def _drop(self) -> None:
        if self._sock is not None:
            self._sock.close()
        self._sock = None
        self._input = None


class TcpChannel(_StreamChannel):
    def _open(self, deadline: float) -> None:
        if self._sock is None:
            self._sock = self._connect(deadline)
            self._input = _Input(self._sock)

    def _send(self, data: bytes, deadline: float) -> None:
        assert self._sock is not None
        self._sock.sendall(data)

    def _receive(self, deadline: float) -> Optional[bytes]:
        assert self._input is not None
        return _read_frame(self._input, deadline)


class UdpChannel(Channel):
    def __init__(self, address: str) -> None:
        self._address = address
        self._sock: Optional[socket.socket] = None

    def _open(self, deadline: float) -> None:
        if self._sock is None:
            host, port = _split(self._address)
            info = socket.getaddrinfo(host, port, type=socket.SOCK_DGRAM)[0]
            self._sock = socket.socket(info[0], socket.SOCK_DGRAM)
            self._sock.connect(info[4])

    def _send(self, data: bytes, deadline: float) -> None:
        if len(data) > MAX_DATAGRAM:
            raise RemoteError('frame too large for a datagram')
        assert self._sock is not None
        self._sock.send(data)

    def _receive(self, deadline: float) -> Optional[bytes]:
        assert self._sock is not None
        return self._sock.recv(65536) if _await(self._sock, deadline, None) else None

    def _drop(self) -> None:
        if self._sock is not None:
            self._sock.close()
        self._sock = None


class HttpChannel(_StreamChannel):
    """One POST per call, on a connection of its own."""

    def __init__(self, address: str, path: str) -> None:
        super().__init__(address)
        self._path = path
        self._reply: Optional[bytes] = None

    def _send(self, data: bytes, deadline: float) -> None:
        self._reply = None
        sock = self._connect(deadline)
        try:
            host = _split(self._address)[0]
            sock.sendall(
                f'POST {self._path} HTTP/1.1\r\nHost: {host}\r\nContent-Type: application/octet-stream\r\n'
                f'Content-Length: {len(data)}\r\nConnection: close\r\n\r\n'.encode() + data)
            stream = _Input(sock)
            head = stream.until(b'\r\n\r\n', 16384, deadline)
            body = stream.take(_content_length(head), deadline) if head is not None else None
            if head is None or body is None:
                raise RemoteError('no HTTP response in time')
            status = head[9:12].decode('latin-1')
            if status == '200':
                self._reply = body
            elif status != '204':
                raise RemoteError(f"HTTP {status} {body.decode('utf-8', 'replace')}")
        finally:
            sock.close()

    def _receive(self, deadline: float) -> Optional[bytes]:
        reply, self._reply = self._reply, None
        return reply


class WebSocketChannel(_StreamChannel):
    def __init__(self, address: str, path: str) -> None:
        super().__init__(address)
        self._path = path

    def _open(self, deadline: float) -> None:
        if self._sock is not None:
            return
        self._sock = self._connect(deadline)
        self._input = _Input(self._sock)
        key = base64.b64encode(os.urandom(16)).decode()
        host = _split(self._address)[0]
        self._sock.sendall(
            f'GET {self._path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
            f'Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n'.encode())
        head = self._input.until(b'\r\n\r\n', 16384, deadline)
        if head is None:
            raise RemoteError('no WebSocket handshake in time')
        if not head.startswith(b'HTTP/1.1 101') or _header_value(head, 'sec-websocket-accept') != _accept_key(key):
            raise RemoteError('WebSocket handshake refused')

    def _send(self, data: bytes, deadline: float) -> None:
        assert self._sock is not None
        self._sock.sendall(_ws_frame(_BINARY, data, True))

    def _receive(self, deadline: float) -> Optional[bytes]:
        assert self._sock is not None and self._input is not None
        return _ws_read(self._sock, self._input, True, deadline)


class ShmChannel(Channel):
    """Opens the segment made by the server (waiting for it), writes the calls ring, reads the
    replies ring. One client per link."""

    def __init__(self, address: str) -> None:
        self._name = _shm_name(address)
        self._shm = None
        self._rings: Optional[Tuple[_Ring, _Ring]] = None

    def _attach(self) -> bool:
        try:
            shm = _shm_open(self._name)
        except FileNotFoundError:
            return False
        buf = shm.buf
        ok = (shm.size >= _shm_size(0) and _U32.unpack_from(buf, 0)[0] == SHM_MAGIC
              and _shm_size(_U32.unpack_from(buf, 4)[0]) <= shm.size)
        if not ok:
            del buf
            shm.close()
            return False
        self._shm = shm
        self._rings = _rings(buf)
        return True

    def _open(self, deadline: float) -> None:
        if self._shm is None and not _wait_for(self._attach, deadline):
            raise RemoteError(f'no shared memory /{self._name}')

    def _send(self, data: bytes, deadline: float) -> None:
        assert self._rings is not None
        calls = self._rings[0]
        if not _wait_for(lambda: calls.push(data), deadline):
            raise RemoteError('shared memory ring full')

    def _receive(self, deadline: float) -> Optional[bytes]:
        assert self._rings is not None
        replies = self._rings[1]
        return _wait_for(replies.pop, deadline)  # type: ignore[return-value]

    def _drop(self) -> None:
        self._rings = None
        if self._shm is not None:
            self._shm.close()
        self._shm = None


def connect(transport: str, address: str, path: str = '/') -> Channel:
    """Channel to the server at `address` (`host:port`, or a name for shm); `path`: request path of
    http and websocket."""
    if transport == 'tcp':
        return TcpChannel(address)
    if transport == 'udp':
        return UdpChannel(address)
    if transport == 'http':
        return HttpChannel(address, path)
    if transport == 'websocket':
        return WebSocketChannel(address, path)
    if transport == 'shm':
        return ShmChannel(address)
    raise RemoteError(f"transport '{transport}' is not generated: write a Channel for it")


class Caller:
    """Numbered calls over a channel, one at a time: what proxies are made of."""

    def __init__(self, channel: Channel, ack: bool = False, timeout: float = 5.0) -> None:
        self.channel = channel
        self.ack = ack
        self.timeout = timeout
        self._lock = threading.Lock()
        self._next = 0

    def call(self, message: int, inputs: Writer, result: bool) -> Reader:
        """Sends message `message` with its encoded inputs; waits for the reply when the message has
        a result, or the link acknowledges calls. Returns a reader of the reply (empty without)."""
        with self._lock:
            wait = result or self.ack
            self._next = (self._next + 1) & 0xFFFFFFFF
            data = frame(CALL, WANT_REPLY if wait else 0, message, self._next, bytes(inputs.data))
            reply = self.channel.exchange(data, wait, self.timeout)
        if reply is None:
            return Reader(b'')
        kind = header(reply)[0]
        body = payload(reply)
        if kind == ERROR:
            raise RemoteError('remote call failed: ' + Reader(body).string())
        if kind != REPLY:
            raise RemoteError('not a reply')
        return Reader(body)

    def close(self) -> None:
        self.channel.close()


# Servers.


class Server:
    """Server end of a link: receives the calls on threads of its own until close()."""

    def __init__(self, handler: Handler) -> None:
        self.handler = handler
        self._stop = threading.Event()
        self._threads: List[threading.Thread] = []
        self._lock = threading.Lock()

    def _spawn(self, run: Callable[..., None], *args: object) -> None:
        def main() -> None:
            try:
                run(*args)
            except (_Closed, ConnectionError):
                pass
            except Exception as e:  # noqa: BLE001
                _log.error('remote server: %s', e)

        with self._lock:
            self._threads = [t for t in self._threads if t.is_alive()]
            t = threading.Thread(target=main, daemon=True)
            self._threads.append(t)
        t.start()

    def close(self) -> None:
        self._stop.set()
        while True:
            with self._lock:
                threads, self._threads = self._threads, []
            if not threads:
                break
            for t in threads:
                if t is not threading.current_thread():
                    t.join()
        self._cleanup()

    def _cleanup(self) -> None:
        pass

    def __enter__(self) -> Server:
        return self

    def __exit__(self, *_: object) -> None:
        self.close()


class _StreamServer(Server):
    """Handles the connections of a stream socket, one thread each."""

    def __init__(self, address: str, handler: Handler) -> None:
        super().__init__(handler)
        self._listener = socket.create_server(_split(address), family=_family(address))
        self._spawn(self._accept)

    def _accept(self) -> None:
        while _await(self._listener, None, self._stop):
            sock, _ = self._listener.accept()
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            self._spawn(self._run, sock)

    def _run(self, sock: socket.socket) -> None:
        with sock:
            self._session(sock)

    def _session(self, sock: socket.socket) -> None:
        raise NotImplementedError

    def _cleanup(self) -> None:
        self._listener.close()


def _family(address: str) -> int:
    return socket.AF_INET6 if ':' in _split(address)[0] else socket.AF_INET


class TcpServer(_StreamServer):
    def _session(self, sock: socket.socket) -> None:
        stream = _Input(sock)
        while True:
            call = _read_frame(stream, None, self._stop)
            if call is None:
                return
            reply = self.handler(call)
            if reply is not None:
                sock.sendall(reply)


def _http_response(status: str, body: bytes, kind: str) -> bytes:
    return f'HTTP/1.1 {status}\r\nContent-Type: {kind}\r\nContent-Length: {len(body)}\r\n\r\n'.encode() + body


class HttpServer(_StreamServer):
    def _session(self, sock: socket.socket) -> None:
        stream = _Input(sock)
        while True:
            head = stream.until(b'\r\n\r\n', 16384, None, self._stop)
            if head is None:
                return
            body = stream.take(_content_length(head), None, self._stop)
            if body is None:
                return
            if not head.startswith(b'POST '):
                response = _http_response('405 Method Not Allowed', b'', 'text/plain')
            else:
                try:
                    reply = self.handler(body)
                    response = (_http_response('200 OK', reply, 'application/octet-stream') if reply is not None
                                else _http_response('204 No Content', b'', 'text/plain'))
                except Exception as e:  # noqa: BLE001
                    response = _http_response('400 Bad Request', str(e).encode(), 'text/plain')
            sock.sendall(response)
            if (_header_value(head, 'connection') or '').lower() == 'close':
                return


class WebSocketServer(_StreamServer):
    def _session(self, sock: socket.socket) -> None:
        stream = _Input(sock)
        head = stream.until(b'\r\n\r\n', 16384, None, self._stop)
        if head is None:
            return
        key = _header_value(head, 'sec-websocket-key')
        if key is None or not head.startswith(b'GET '):
            sock.sendall(_http_response('400 Bad Request', b'WebSocket only', 'text/plain'))
            return
        sock.sendall(('HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
                      f'Sec-WebSocket-Accept: {_accept_key(key)}\r\n\r\n').encode())
        while True:
            message = _ws_read(sock, stream, False, None, self._stop)
            if message is None:
                return
            reply = self.handler(message)
            if reply is not None:
                sock.sendall(_ws_frame(_BINARY, reply, False))


class UdpServer(Server):
    def __init__(self, address: str, handler: Handler) -> None:
        super().__init__(handler)
        host, port = _split(address)
        self._sock = socket.socket(_family(address), socket.SOCK_DGRAM)
        self._sock.bind((host, port))
        self._spawn(self._run)

    def _run(self) -> None:
        while _await(self._sock, None, self._stop):
            data, sender = self._sock.recvfrom(65536)
            try:
                reply = self.handler(data)
                if reply is None:
                    continue
                if len(reply) > MAX_DATAGRAM:
                    reply = error_frame(header(data)[3], 'reply too large for a datagram')
                self._sock.sendto(reply, sender)
            except RemoteError:
                pass  # not a frame

    def _cleanup(self) -> None:
        self._sock.close()


class ShmServer(Server):
    """Makes the segment (replacing a stale one), reads the calls ring, writes the replies ring."""

    def __init__(self, address: str, handler: Handler, capacity: int = RING_CAPACITY) -> None:
        super().__init__(handler)
        self._name = _shm_name(address)
        _shm_unlink(self._name)
        self._shm = _shm_open(self._name, create=True, size=_shm_size(capacity))
        buf = self._shm.buf
        _U32.pack_into(buf, 4, capacity)
        _U32.pack_into(buf, 0, SHM_MAGIC)
        self._rings = _rings(buf)
        del buf
        self._spawn(self._run)

    def _run(self) -> None:
        calls, replies = self._rings
        while True:
            call = _wait_for(calls.pop, None, self._stop)
            if call is None:
                return
            try:
                reply = self.handler(call)  # type: ignore[arg-type]
            except RemoteError:
                continue
            if reply is not None:
                # A reply finding no room within a second is lost: the client gave up on it.
                _wait_for(lambda: replies.push(reply), time.monotonic() + 1.0, self._stop)

    def _cleanup(self) -> None:
        self._rings = None  # type: ignore[assignment]
        self._shm.close()
        self._shm.unlink()


def serve(transport: str, address: str, handler: Handler, capacity: int = RING_CAPACITY) -> Server:
    """Server at `address`, calling `handler` for each call received; `capacity`: bytes of each ring
    of shm."""
    if transport == 'tcp':
        return TcpServer(address, handler)
    if transport == 'udp':
        return UdpServer(address, handler)
    if transport == 'http':
        return HttpServer(address, handler)
    if transport == 'websocket':
        return WebSocketServer(address, handler)
    if transport == 'shm':
        return ShmServer(address, handler, capacity)
    raise RemoteError(f"transport '{transport}' is not generated: write a Server for it")
