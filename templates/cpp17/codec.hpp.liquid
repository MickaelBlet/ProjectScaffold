// Encoding of the types of the calls between binaries (enums and aliases need none: see wire.hpp).
namespace {{ project.ident | snake }}::remote {

{% for t in remoteTypes %}
{% if t.kind == 'struct' %}
inline void encode(Writer& w, const {% render '_qualified', e: t %}& v);
inline void decode(Reader& r, {% render '_qualified', e: t %}& v);
{% endif %}
