{% include '_banner.liquid' %}
#pragma once

{% assign includes = item | cpp_includes %}
{% for inc in includes %}
#include {{ inc }}
{% endfor %}
{% user 'includes' %}
{% enduser %}

namespace {{ item | cpp_namespace }} {

{{ item.description | doc_comment }}
{% case item.kind %}
{% when 'struct' %}
struct {{ item | cpp_name }} {
{% for f in item.fields %}
{{ f.description | doc_comment: '    /// ' }}
    {{ f.type | cpp_type }} {{ f.name | cpp_id }}{% if f.hasDefault %} = {{ f.default | cpp_value: f.type }}{% else %}{}{% endif %};
{% endfor %}
    {% user 'members' %}
    {% enduser %}
};
{% when 'enum' %}
enum class {{ item | cpp_name }} : {{ item.underlying | cpp_primitive }} {
{% for v in item.values %}
    {{ v.name | cpp_id }} = {{ v.value }},
{% endfor %}
};
{% when 'alias' %}
using {{ item | cpp_name }} = {{ item.type | cpp_type }};
{% when 'primitive' %}
{% user 'definition' %}
using {{ item | cpp_name }} = void*; // TODO: native type of {{ item.name }}
{% enduser %}
{% endcase %}

} // namespace {{ item | cpp_namespace }}
