# Generated by ProjectScaffold ({{ generator.name }}) from project '{{ project.name }}'.
# Regenerating keeps only the code written inside the user sections.
{% assign ns = project.ident | snake %}
cmake_minimum_required(VERSION 3.16)
project({{ ns }} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

{% user 'options' %}
{% enduser %}

{% assign sources = 0 %}
{% for f in files %}
{% if f contains '.cpp' and f != 'src/main.cpp' %}
{% assign sources = sources | plus: 1 %}
{% endif %}
{% endfor %}
{% if sources > 0 %}
add_library({{ ns }}
{% for f in files %}
{% if f contains '.cpp' and f != 'src/main.cpp' %}
    {{ f }}
{% endif %}
{% endfor %}
)
set(SCAFFOLD_SCOPE PUBLIC)
{% else %}
add_library({{ ns }} INTERFACE)
set(SCAFFOLD_SCOPE INTERFACE)
{% endif %}
target_include_directories({{ ns }} ${SCAFFOLD_SCOPE} ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features({{ ns }} ${SCAFFOLD_SCOPE} cxx_std_17)

{% user 'dependencies' %}
{% for d in dependencies %}
{% assign dep = d.name | snake %}
if(NOT TARGET {{ dep }} AND EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }}/CMakeLists.txt)
    add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }} ${CMAKE_CURRENT_BINARY_DIR}/{{ dep }})
endif()
if(TARGET {{ dep }})
    target_link_libraries({{ ns }} ${SCAFFOLD_SCOPE} {{ dep }})
else()
    message(WARNING "dependency {{ d.name }} ({{ d.file }}) not found: generate it in ../{{ dep }}")
endif()
{% endfor %}
{% enduser %}
{% if modules.size > 0 %}

add_executable({{ ns }}_app src/main.cpp)
target_link_libraries({{ ns }}_app PRIVATE {{ ns }})
{% endif %}

{% user 'end' %}
{% enduser %}
