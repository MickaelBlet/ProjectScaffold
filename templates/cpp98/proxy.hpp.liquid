{% include '_banner' %}
#pragma once

#include <{% render '_header', e: item %}>
#include <{{ project.ident | snake }}/remote/codec.hpp>
#include <{{ project.ident | snake }}/remote/transport.hpp>
{% user 'includes' %}
{% enduser %}

{% assign remoteNs = project.ident | snake | append: '::remote' %}
{% render '_namespace_open', ns: remoteNs %}

/// {% render '_name', e: item %} of another binary: each call is encoded and sent over the channel
/// given to open(), and waits for its reply when it has a result or the link acknowledges calls.
class {{ item.name }}Proxy : public {% render '_qualified', e: item %} {
public:
    /// Sends the calls over `channel` (deleted with the proxy); `ack`: every call waits for its
    /// reply, within `timeoutMs` milliseconds.
    void open(Channel* channel, bool ack = false, long timeoutMs = 5000) { caller_.open(channel, ack, timeoutMs); }
{% for msg in item.messages %}
{% capture wait %}{% if msg.returns or msg.outputs.size > 0 %}true{% else %}false{% endif %}{% endcapture -%}
{% # Declared exceptions thrown as such. %}

    {% render '_type', t: msg.returns %} {% render '_id', name: msg.name %}({% render '_params', params: msg.params %})
    {
        Writer request_;
{% for p in msg.inputs %}
{% capture value %}{% render '_id', name: p.name %}{% endcapture -%}
{% capture check %}{% render '_bounds', t: p.type, v: value, depth: 0 %}{% endcapture -%}
{% if check != '' %}
        {{ check }}
{% endif %}
        encode(request_, {{ value }});
{% endfor %}
{% if msg.raises.size > 0 %}
        Bytes reply_;
        try {
            reply_ = caller_.call({{ forloop.index0 }}, request_.bytes(), {{ wait }});
        } catch (const Raised& e) {
{% for r in msg.raises %}
            if (e.index == {{ forloop.index0 }}) raiseAs< {% render '_type', t: r %}>(e);
{% endfor %}
            throw Error(e.what());
        }
{% elsif wait == 'true' %}
        const Bytes reply_ = caller_.call({{ forloop.index0 }}, request_.bytes(), true);
{% else %}
        caller_.call({{ forloop.index0 }}, request_.bytes(), false);
{% endif %}
{% if wait == 'true' %}
        Reader reader_(reply_);
{% if msg.returns %}
        {% render '_type', t: msg.returns %} result_ = {% render '_type', t: msg.returns %}();
        decode(reader_, result_);
{% capture check %}{% render '_bounds', t: msg.returns, v: 'result_', depth: 0 %}{% endcapture -%}
{% if check != '' %}
        {{ check }}
{% endif %}
{% endif %}
{% for p in msg.outputs %}
{% capture value %}{% render '_id', name: p.name %}{% endcapture -%}
{% capture check %}{% render '_bounds', t: p.type, v: value, depth: 0 %}{% endcapture -%}
{% # Decoded, then checked. %}
        decode(reader_, {{ value }});
{% if check != '' %}
        {{ check }}
{% endif %}
{% endfor %}
        reader_.end();
{% if msg.returns %}
        return result_;
{% endif %}
{% endif %}
    }
{% endfor %}

    {% user 'public' %}
    {% enduser %}

private:
    Caller caller_;
    {% user 'private' %}
    {% enduser %}
};

{% render '_namespace_close', ns: remoteNs %}
