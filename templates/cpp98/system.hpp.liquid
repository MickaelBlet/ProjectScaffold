{% include '_banner' %}
#pragma once

{% render '_includes', e: system %}
{%- liquid
  assign remote = ''
  for r in system.proxies
    assign remote = remote | append: r.interface.name | append: 'Proxy,'
  endfor
  for r in system.stubs
    assign remote = remote | append: r.interface.name | append: 'Stub,'
  endfor
  assign remote = remote | split: ',' | uniq | sort
-%}
{% for r in remote %}
#include <{{ project.ident | snake }}/remote/{{ r }}.hpp>
{% endfor %}
{% user 'includes' %}
{% enduser %}

{% capture ns %}{% render '_ns', e: system %}{% endcapture %}
{% render '_namespace_open', ns: ns %}

{{ project.description | doc_comment }}
{% if system.binary %}
{{ system.binary.description | doc_comment }}
/// The top-level modules of binary {{ system.binary.name }} of {{ project.name }}, wired together and to
/// the other binaries.
{% else %}
/// The top-level modules of {{ project.name }}, wired together.
{% endif %}
class {{ system.name }} {
public:
    {{ system.name }}();
    ~{{ system.name }}();

{% for c in system.instances %}
    {% render '_qualified', e: c %}& {% render '_accessor', name: c.name %}() { return {% if c.abstract %}*{% endif %}{% render '_accessor', name: c.name %}_; }
{% endfor %}

    {% user 'public' %}
    {% enduser %}

private:
    // Not copyable.
    {{ system.name }}(const {{ system.name }}&);
    {{ system.name }}& operator=(const {{ system.name }}&);

{% for c in system.instances %}
{% if c.abstract %}
    {% render '_qualified', e: c %}* {% render '_accessor', name: c.name %}_; // abstract: created in the constructor, deleted by the destructor
{% else %}
    {% render '_qualified', e: c %} {% render '_accessor', name: c.name %}_;
{% endif %}
{% endfor %}
{% for r in system.proxies %}
    remote::{{ r.interface.name }}Proxy {{ r.link.name | camel }}Proxy_; // {{ r.link.name }}, to binary {{ r.peer.binary }}
{% endfor %}
{% for r in system.stubs %}
    remote::{{ r.interface.name }}Stub {{ r.link.name | camel }}Stub_; // {{ r.link.name }}, from binary {{ r.peer.binary }}
{% endfor %}
    {% user 'private' %}
    {% enduser %}
};

{% render '_namespace_close', ns: ns %}
