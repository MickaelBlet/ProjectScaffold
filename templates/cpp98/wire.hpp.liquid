/// Failure of a remote call: transport, timeout, malformed frame, or error sent back by the peer.
class Error : public std::runtime_error {
public:
    explicit Error(const std::string& what) : std::runtime_error(what) {}
};

typedef std::vector<uint8_t> Bytes;

/// The bytes of `b`; null when empty.
inline const uint8_t* dataOf(const Bytes& b) { return b.empty() ? 0 : &b[0]; }
inline uint8_t* dataOf(Bytes& b) { return b.empty() ? 0 : &b[0]; }

/// A number as text (std::to_string of C++11).
template <class T>
std::string toString(T value)
{
    std::ostringstream out;
    out << value;
    return out.str();
}

inline bool littleEndian()
{
    const uint16_t one = 1;
    uint8_t first = 0;
    std::memcpy(&first, &one, 1);
    return first == 1;
}

class Writer {
public:
    void raw(const void* data, std::size_t size)
    {
        const uint8_t* p = static_cast<const uint8_t*>(data);
        bytes_.insert(bytes_.end(), p, p + size);
    }

    /// An arithmetic value, little-endian.
    template <class T>
    void number(T value)
    {
        uint8_t b[sizeof(T)];
        std::memcpy(b, &value, sizeof(T));
        if (!littleEndian()) std::reverse(b, b + sizeof(T));
        raw(b, sizeof(T));
    }

    void count(std::size_t n)
    {
        if (n > 0xffffffffu) throw Error("too many items to encode");
        number(static_cast<uint32_t>(n));
    }

    const Bytes& bytes() const { return bytes_; }

private:
    Bytes bytes_;
};

class Reader {
public:
    Reader(const uint8_t* data, std::size_t size) : data_(data), size_(size), pos_(0) {}
    explicit Reader(const Bytes& bytes) : data_(dataOf(bytes)), size_(bytes.size()), pos_(0) {}

    void raw(void* out, std::size_t size)
    {
        if (size > remaining()) throw Error("truncated frame");
        if (size) std::memcpy(out, data_ + pos_, size);
        pos_ += size;
    }

    /// An arithmetic value, little-endian.
    template <class T>
    T number()
    {
        uint8_t b[sizeof(T)];
        raw(b, sizeof(T));
        if (!littleEndian()) std::reverse(b, b + sizeof(T));
        T value;
        std::memcpy(&value, b, sizeof(T));
        return value;
    }

    std::size_t count() { return number<uint32_t>(); }

    std::size_t remaining() const { return size_ - pos_; }

    /// Throws unless everything was read.
    void end() const
    {
        if (pos_ != size_) throw Error("unexpected bytes at the end of a frame");
    }

private:
    const uint8_t* data_;
    std::size_t size_;
    std::size_t pos_;
};

// encode(Writer&, const T&) and decode(Reader&, T&) for each type; those of the types of the
// project (enums and bitmasks included) are in codec.hpp.

/// Throws when a string, bytes or container is over its bound (`string<16>`, `vector<T, 8>`).
template <class T>
void checkBound(const T& v, std::size_t max)
{
    if (v.size() > max) throw Error("size " + toString(v.size()) + " over the bound of " + toString(max));
}

inline void encode(Writer& w, bool v) { w.number<uint8_t>(v ? 1 : 0); }
inline void decode(Reader& r, bool& v) { v = r.number<uint8_t>() != 0; }

inline void encode(Writer& w, char v) { w.number(static_cast<uint8_t>(v)); }
inline void decode(Reader& r, char& v) { v = static_cast<char>(r.number<uint8_t>()); }

// Numbers: their bytes.
inline void encode(Writer& w, int8_t v) { w.number(v); }
inline void decode(Reader& r, int8_t& v) { v = r.number<int8_t>(); }
inline void encode(Writer& w, uint8_t v) { w.number(v); }
inline void decode(Reader& r, uint8_t& v) { v = r.number<uint8_t>(); }
inline void encode(Writer& w, int16_t v) { w.number(v); }
inline void decode(Reader& r, int16_t& v) { v = r.number<int16_t>(); }
inline void encode(Writer& w, uint16_t v) { w.number(v); }
inline void decode(Reader& r, uint16_t& v) { v = r.number<uint16_t>(); }
inline void encode(Writer& w, int32_t v) { w.number(v); }
inline void decode(Reader& r, int32_t& v) { v = r.number<int32_t>(); }
inline void encode(Writer& w, uint32_t v) { w.number(v); }
inline void decode(Reader& r, uint32_t& v) { v = r.number<uint32_t>(); }
inline void encode(Writer& w, int64_t v) { w.number(v); }
inline void decode(Reader& r, int64_t& v) { v = r.number<int64_t>(); }
inline void encode(Writer& w, uint64_t v) { w.number(v); }
inline void decode(Reader& r, uint64_t& v) { v = r.number<uint64_t>(); }
inline void encode(Writer& w, float v) { w.number(v); }
inline void decode(Reader& r, float& v) { v = r.number<float>(); }
inline void encode(Writer& w, double v) { w.number(v); }
inline void decode(Reader& r, double& v) { v = r.number<double>(); }

inline void encode(Writer& w, const std::string& v)
{
    w.count(v.size());
    w.raw(v.data(), v.size());
}
inline void decode(Reader& r, std::string& v)
{
    const std::size_t n = r.count();
    if (n > r.remaining()) throw Error("truncated frame");
    v.resize(n);
    if (n) r.raw(&v[0], n);
}

inline void encode(Writer& w, const Bytes& v)
{
    w.count(v.size());
    w.raw(dataOf(v), v.size());
}
inline void decode(Reader& r, Bytes& v)
{
    const std::size_t n = r.count();
    if (n > r.remaining()) throw Error("truncated frame");
    v.resize(n);
    r.raw(dataOf(v), n);
}

template <class T>
void encode(Writer& w, const std::vector<T>& v)
{
    w.count(v.size());
    for (std::size_t i = 0; i < v.size(); ++i) encode(w, v[i]);
}
template <class T>
void decode(Reader& r, std::vector<T>& v)
{
    const std::size_t n = r.count();
    v.clear();
    v.reserve(std::min(n, r.remaining()));
    for (std::size_t i = 0; i < n; ++i) {
        v.push_back(T());
        decode(r, v.back());
    }
}

template <class T>
void encode(Writer& w, const std::list<T>& v)
{
    w.count(v.size());
    for (typename std::list<T>::const_iterator it = v.begin(); it != v.end(); ++it) encode(w, *it);
}
template <class T>
void decode(Reader& r, std::list<T>& v)
{
    const std::size_t n = r.count();
    v.clear();
    for (std::size_t i = 0; i < n; ++i) {
        v.push_back(T());
        decode(r, v.back());
    }
}

template <class T>
void encode(Writer& w, const std::set<T>& v)
{
    w.count(v.size());
    for (typename std::set<T>::const_iterator it = v.begin(); it != v.end(); ++it) encode(w, *it);
}
template <class T>
void decode(Reader& r, std::set<T>& v)
{
    const std::size_t n = r.count();
    v.clear();
    for (std::size_t i = 0; i < n; ++i) {
        T x = T();
        decode(r, x);
        v.insert(x);
    }
}

template <class T, std::size_t N>
void encode(Writer& w, const scaffold::Array<T, N>& v)
{
    for (std::size_t i = 0; i < N; ++i) encode(w, v[i]);
}
template <class T, std::size_t N>
void decode(Reader& r, scaffold::Array<T, N>& v)
{
    for (std::size_t i = 0; i < N; ++i) decode(r, v[i]);
}

template <class T>
void encode(Writer& w, const scaffold::Optional<T>& v)
{
    w.number<uint8_t>(v ? 1 : 0);
    if (v) encode(w, *v);
}
template <class T>
void decode(Reader& r, scaffold::Optional<T>& v)
{
    if (r.number<uint8_t>()) {
        T x = T();
        decode(r, x);
        v = x;
    } else {
        v.reset();
    }
}

template <class K, class V>
void encode(Writer& w, const std::map<K, V>& v)
{
    w.count(v.size());
    for (typename std::map<K, V>::const_iterator it = v.begin(); it != v.end(); ++it) {
        encode(w, it->first);
        encode(w, it->second);
    }
}
template <class K, class V>
void decode(Reader& r, std::map<K, V>& v)
{
    const std::size_t n = r.count();
    v.clear();
    for (std::size_t i = 0; i < n; ++i) {
        K key = K();
        decode(r, key);
        decode(r, v[key]);
    }
}

/// Frame header.
struct Header {
    static const std::size_t size = 16;
    /// Largest payload accepted.
    static const uint32_t maxLength = 64u << 20;
    enum Kind { call = 1, reply = 2, error = 3 };
    /// Flag of a call waiting for its reply.
    static const uint8_t wantReply = 1;
    /// Flag of an error frame holding a declared exception.
    static const uint8_t typed = 2;

    Header() : kind(call), flags(0), message(0), id(0), length(0) {}

    uint8_t kind;
    uint8_t flags;
    uint16_t message;
    uint32_t id;
    uint32_t length;
};

inline Bytes frame(Header h, const Bytes& payload)
{
    if (payload.size() > Header::maxLength) throw Error("frame too large");
    h.length = static_cast<uint32_t>(payload.size());
    Writer w;
    w.raw("SCF1", 4);
    w.number(h.kind);
    w.number(h.flags);
    w.number(h.message);
    w.number(h.id);
    w.number(h.length);
    w.raw(dataOf(payload), payload.size());
    return w.bytes();
}

/// Header of a frame; `size` may hold the header only.
inline Header header(const uint8_t* data, std::size_t size)
{
    if (size < Header::size || std::memcmp(data, "SCF1", 4) != 0) throw Error("not a frame");
    Reader r(data + 4, Header::size - 4);
    Header h;
    h.kind = r.number<uint8_t>();
    h.flags = r.number<uint8_t>();
    h.message = r.number<uint16_t>();
    h.id = r.number<uint32_t>();
    h.length = r.number<uint32_t>();
    if (h.length > Header::maxLength) throw Error("frame too large");
    return h;
}

inline Header header(const Bytes& frame) { return header(dataOf(frame), frame.size()); }

/// The payload of a whole frame.
inline Bytes payload(const Bytes& frame)
{
    const Header h = header(frame);
    if (frame.size() != Header::size + h.length) throw Error("frame of the wrong size");
    return Bytes(frame.begin() + Header::size, frame.end());
}

/// A declared exception of a remote call (`index` in the `raises` of its message), encoded.
class Raised : public Error {
public:
    Raised(uint16_t index, const Bytes& value, const std::string& what) : Error(what), index(index), value(value)
    {
    }
    ~Raised() throw() {}

    uint16_t index;
    Bytes value;
};

inline Bytes errorFrame(uint32_t id, const std::string& message, const Raised* raised = 0)
{
    Writer w;
    encode(w, message);
    Header h;
    h.kind = Header::error;
    h.id = id;
    if (raised) {
        h.flags = Header::typed;
        w.number(raised->index);
        w.raw(dataOf(raised->value), raised->value.size());
    }
    return frame(h, w.bytes());
}

/// The calls of an interface, made from their encoded inputs (see respond()).
class Calls {
public:
    virtual ~Calls() {}
    /// Makes call `message`, its inputs read from `in`, its result and outputs written to `out`:
    /// false for an unknown message.
    virtual bool call(uint16_t message, Reader& in, Writer& out) = 0;
};

/// Answers a call frame through `calls`: true with the reply frame in `reply`, false when the
/// call wants none. Failures are sent back as error frames, or written to std::cerr when no reply
/// is wanted.
inline bool respond(const Bytes& call, Calls& calls, Bytes& reply)
{
    const Header h = header(call);
    const bool wanted = (h.flags & Header::wantReply) != 0;
    std::string failure;
    scaffold::Optional<Raised> raised;
    try {
        if (h.kind != Header::call) throw Error("not a call");
        const Bytes in = payload(call);
        Reader reader(in);
        Writer writer;
        if (!calls.call(h.message, reader, writer)) throw Error("unknown message " + toString(h.message));
        if (!wanted) return false;
        Header r;
        r.kind = Header::reply;
        r.message = h.message;
        r.id = h.id;
        reply = frame(r, writer.bytes());
        return true;
    } catch (const Raised& e) {
        failure = e.what();
        raised = e;
    } catch (const std::exception& e) {
        failure = e.what();
    } catch (...) {
        failure = "unknown exception";
    }
    if (wanted) {
        reply = errorFrame(h.id, failure, raised ? &*raised : 0);
        return true;
    }
    std::cerr << "remote call " << h.message << " failed: " << failure << '\n';
    return false;
}

