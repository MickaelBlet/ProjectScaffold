# Generated by ProjectScaffold ({{ generator.name }}) from project '{{ project.name }}'.
# Regenerating keeps only the code written inside the user sections.
{% assign ns = project.ident | snake %}
cmake_minimum_required(VERSION 3.16)
project({{ ns }} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 11)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

{% user 'options' %}
{% enduser %}

{% assign sources = 0 %}
{% for f in files %}
{% if f contains '.cpp' %}
{% assign sources = sources | plus: 1 %}
{% endif %}
{% endfor %}
{% if sources > 0 %}
add_library({{ ns }}
{% for f in files %}
{% if f contains '.cpp' %}
    {{ f }}
{% endif %}
{% endfor %}
)
set(SCAFFOLD_SCOPE PUBLIC)
{% else %}
add_library({{ ns }} INTERFACE)
set(SCAFFOLD_SCOPE INTERFACE)
{% endif %}
target_include_directories({{ ns }} ${SCAFFOLD_SCOPE} ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features({{ ns }} ${SCAFFOLD_SCOPE} cxx_std_11)

{% if remoteLinks.size > 0 %}
# Transports of the links between binaries (src/remote/transport.cpp).
find_package(Threads REQUIRED)
target_link_libraries({{ ns }} ${SCAFFOLD_SCOPE} Threads::Threads)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries({{ ns }} ${SCAFFOLD_SCOPE} rt)
endif()

{% endif %}
{% user 'dependencies' %}
{% for d in dependencies %}
{% assign dep = d.name | snake %}
if(NOT TARGET {{ dep }} AND EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }}/CMakeLists.txt)
    add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../{{ dep }} ${CMAKE_CURRENT_BINARY_DIR}/{{ dep }})
endif()
if(TARGET {{ dep }})
    target_link_libraries({{ ns }} ${SCAFFOLD_SCOPE} {{ dep }})
else()
    message(WARNING "dependency {{ d.name }} ({{ d.file }}) not found: generate it in ../{{ dep }}")
endif()
{% endfor %}
{% enduser %}
{% if modules.size > 0 %}
{% for system in systems %}
{% if system.binary %}
{% assign exe = ns | append: '_' | append: system.binary.name | snake %}
{% else %}
{% assign exe = ns | append: '_app' %}
{% endif %}

add_executable({{ exe }} src/{% render '_main', system: system %})
target_link_libraries({{ exe }} PRIVATE {{ ns }})
{% endfor %}
{% endif %}

{% user 'end' %}
{% enduser %}
