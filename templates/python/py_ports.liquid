"""Out ports of the modules of {{ project.name }}."""
from __future__ import annotations

from typing import Any, Callable, Generic, List, TypeVar

T = TypeVar('T')


class OutPort(Generic[T]):
    """Out port of a module: its calls go to the `in` ports it is connected to, and to those of the
    out ports it forwards to (the out ports of enclosing modules it goes out through).

    `port.method(...)` calls the only peer (RuntimeError unless exactly one is connected);
    `port.each(f)` calls `f(peer)` for each."""

    def __init__(self) -> None:
        self._peers: List[T] = []
        self._forwards: List[OutPort[T]] = []

    def connect(self, peer: T) -> None:
        """Sends the calls of this port to `peer`."""
        self._peers.append(peer)

    def forward(self, port: OutPort[T]) -> None:
        """Sends the calls of this port to the peers of `port` as well."""
        self._forwards.append(port)

    def peers(self) -> List[T]:
        """Every peer, forwarded ones included."""
        found = list(self._peers)
        for port in self._forwards:
            found.extend(port.peers())
        return found

    @property
    def connected(self) -> bool:
        return bool(self.peers())

    @property
    def peer(self) -> T:
        """The only peer."""
        found = self.peers()
        if len(found) != 1:
            raise RuntimeError('out port with no or several peers')
        return found[0]

    def each(self, f: Callable[[T], Any]) -> None:
        for peer in self.peers():
            f(peer)

    def __getattr__(self, name: str) -> Any:
        if name.startswith('_'):
            raise AttributeError(name)
        return getattr(self.peer, name)
