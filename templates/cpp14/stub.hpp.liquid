{% include '_banner' %}
#pragma once

#include <{% render '_header', e: item %}>
#include <{{ project.ident | snake }}/remote/codec.hpp>
#include <{{ project.ident | snake }}/remote/transport.hpp>
{% user 'includes' %}
{% enduser %}

{% assign remoteNs = project.ident | snake | append: '::remote' %}
{% render '_namespace_open', ns: remoteNs %}

/// Receives the calls of {% render '_name', e: item %} from another binary and makes them on the
/// port bound. The calls come on the threads of the transport: several at once over tcp, http and
/// websocket (one per connection).
class {{ item.name }}Stub {
public:
    {{ item.name }}Stub() = default;
    {{ item.name }}Stub(const {{ item.name }}Stub&) = delete;
    {{ item.name }}Stub& operator=(const {{ item.name }}Stub&) = delete;
    ~{{ item.name }}Stub() { server_.reset(); }

    void bind({% render '_qualified', e: item %}& target) { target_ = &target; }

    /// Receives the calls over `transport`, at `address`; `capacity`: bytes of each ring of shm.
    void serve(const std::string& transport, const std::string& address,
               std::uint32_t capacity = remote::ringCapacity)
    {
        server_ = remote::serve(
            transport, address, [this](const Bytes& frame) { return dispatch(frame); }, capacity);
    }

    /// Makes the call of a frame: the reply frame, or nothing when the call wants none.
    scaffold::Optional<Bytes> dispatch(const Bytes& frame)
    {
        return respond(frame, [this](std::uint16_t message_, Reader& reader_, Writer& writer_) {
            (void)writer_;
            if (!target_) throw Error("{{ item.name }}Stub not bound");
            switch (message_) {
{% for msg in item.messages %}
            case {{ forloop.index0 }}: {
{% for p in msg.params %}
                {% render '_type', t: p.type %} {% render '_id', name: p.name %}{};
{% endfor %}
{% for p in msg.inputs %}
{% capture value %}{% render '_id', name: p.name %}{% endcapture -%}
{% capture check %}{% render '_bounds', t: p.type, v: value, depth: 0 %}{% endcapture -%}
{% # Decoded, then checked. %}
                decode(reader_, {{ value }});
{% if check != '' %}
                {{ check }}
{% endif %}
{% endfor %}
                reader_.end();
{% capture call %}
{% if msg.returns %}
{% capture check %}{% render '_bounds', t: msg.returns, v: 'result_', depth: 0 %}{% endcapture -%}
{% if check != '' %}
                const auto result_ = target_->{% render '_id', name: msg.name %}({% render '_args', params: msg.params %});
                {{ check }}
                encode(writer_, result_);
{% else %}
                encode(writer_, target_->{% render '_id', name: msg.name %}({% render '_args', params: msg.params %}));
{% endif %}
{% else %}
                target_->{% render '_id', name: msg.name %}({% render '_args', params: msg.params %});
{% endif %}
{% for p in msg.outputs %}
{% capture value %}{% render '_id', name: p.name %}{% endcapture -%}
{% capture check %}{% render '_bounds', t: p.type, v: value, depth: 0 %}{% endcapture -%}
{% if check != '' %}
                {{ check }}
{% endif %}
                encode(writer_, {{ value }});
{% endfor %}
{% endcapture %}
{% if msg.raises.size > 0 %}
                try {
{{ call | rstrip | replace: '\n', '\n    ' | prepend: '    ' }}
{% for r in msg.raises %}
                } catch (const {% render '_type', t: r %}& e) {
                    throw raised({{ forloop.index0 }}, e);
{% endfor %}
                }
{% else %}
{{ call | rstrip }}
{% endif %}
                return true;
            }
{% endfor %}
            default:
                return false;
            }
        });
    }

    {% user 'public' %}
    {% enduser %}

private:
    {% render '_qualified', e: item %}* target_ = nullptr;
    std::unique_ptr<Server> server_;
    {% user 'private' %}
    {% enduser %}
};

{% render '_namespace_close', ns: remoteNs %}
