<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE softwarecomponent PUBLIC "-//JTRS//DTD SCA V2.2.2 SCD//EN" "softwarecomponent.dtd">
{% include '_xml_banner' %}
{%- liquid
  assign m = item
  capture exposed
    render '_exposed', m: m
  endcapture
  assign exposed = exposed | split: ','
  # Interfaces of the ports: `repid|name` entries.
  assign interfaces = ''
-%}
<softwarecomponent>
    <corbaversion>2.2</corbaversion>
    <componentrepid repid="IDL:CF/Resource:1.0"/>
    <componenttype>resource</componenttype>
    <componentfeatures>
        <supportsinterface repid="IDL:CF/Resource:1.0" supportsname="Resource"/>
        <supportsinterface repid="IDL:CF/LifeCycle:1.0" supportsname="LifeCycle"/>
        <supportsinterface repid="IDL:CF/TestableObject:1.0" supportsname="TestableObject"/>
        <supportsinterface repid="IDL:CF/PropertySet:1.0" supportsname="PropertySet"/>
        <supportsinterface repid="IDL:CF/PortSupplier:1.0" supportsname="PortSupplier"/>
        <ports>
{% for p in m.ports %}
{% if p.interface %}
{%- liquid
  capture repid
    render '_repid', i: p.interface
  endcapture
  assign interfaces = interfaces | append: repid | append: '|' | append: p.interface.name | append: ','
-%}
{% include '_scd_port', role: p.role, name: p.name, repid: repid, description: p.description %}
{% endif %}
{% endfor %}
{% for x in exposed %}
{% assign parts = x | split: ':' %}
{% assign inner = modules | where: 'path', parts[0] | first %}
{% assign innerPort = inner.ports | where: 'name', parts[1] | first %}
{% if innerPort.interface %}
{%- liquid
  capture repid
    render '_repid', i: innerPort.interface
  endcapture
  capture portName
    render '_port_name', module: parts[0], port: parts[1], component: m.path
  endcapture
  assign interfaces = interfaces | append: repid | append: '|' | append: innerPort.interface.name | append: ','
-%}
{% include '_scd_port', role: innerPort.role, name: portName, repid: repid, description: innerPort.description %}
{% endif %}
{% endfor %}
        </ports>
    </componentfeatures>
    <interfaces>
        <interface repid="IDL:CF/Resource:1.0" name="Resource">
            <inheritsinterface repid="IDL:CF/LifeCycle:1.0"/>
            <inheritsinterface repid="IDL:CF/TestableObject:1.0"/>
            <inheritsinterface repid="IDL:CF/PropertySet:1.0"/>
            <inheritsinterface repid="IDL:CF/PortSupplier:1.0"/>
        </interface>
        <interface repid="IDL:CF/LifeCycle:1.0" name="LifeCycle"/>
        <interface repid="IDL:CF/TestableObject:1.0" name="TestableObject"/>
        <interface repid="IDL:CF/PropertySet:1.0" name="PropertySet"/>
        <interface repid="IDL:CF/PortSupplier:1.0" name="PortSupplier"/>
        <interface repid="IDL:CF/Port:1.0" name="Port"/>
{% assign interfaces = interfaces | split: ',' | uniq %}
{% for i in interfaces %}
{% assign parts = i | split: '|' %}
        <interface repid="{{ parts[0] }}" name="{{ parts[1] }}"/>
{% endfor %}
    </interfaces>
</softwarecomponent>
