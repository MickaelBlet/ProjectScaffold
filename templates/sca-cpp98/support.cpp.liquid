// Values and connections

bool fromAny(const ::CORBA::Any& any, ::CORBA::String_var& value)
{
    const char* text = 0;
    if (!(any >>= text) || !text) return false;
    value = text;
    return true;
}

void connect(Resource& user, const char* usesName, Resource& provider, const char* providesName,
    const char* connectionId)
{
    ::CORBA::Object_var uses = user.getPort(usesName);
    ::CF::Port_var port = ::CF::Port::_narrow(uses);
    if (::CORBA::is_nil(port)) throw std::logic_error(std::string(usesName) + " is not a uses port");
    ::CORBA::Object_var provides = provider.getPort(providesName);
    port->connectPort(provides, connectionId);
}

void reportError(const char* where, const ::CORBA::Exception& e)
{
    std::cerr << where << ": CORBA exception " << e._name() << std::endl;
}

void reportError(const char* where, const char* what)
{
    std::cerr << where << ": " << what << std::endl;
}

// ExecParams

ExecParams::ExecParams(int argc, char** argv)
{
    for (int i = 1; i + 1 < argc; i += 2) {
        const std::string name(argv[i]);
        const std::string value(argv[i + 1]);
        if (name == "NAMING_CONTEXT_IOR")
            namingContextIor = value;
        else if (name == "NAME_BINDING")
            nameBinding = value;
        else if (name == "COMPONENT_IDENTIFIER")
            identifier = value;
        else
            others.push_back(std::make_pair(name, value));
    }
}

// Runtime

Runtime::Runtime(int& argc, char** argv) : down_(false)
{
    orb_ = ::CORBA::ORB_init(argc, argv);
    ::CORBA::Object_var root = orb_->resolve_initial_references("RootPOA");
    poa_ = ::PortableServer::POA::_narrow(root);
    ::PortableServer::POAManager_var manager = poa_->the_POAManager();
    manager->activate();
}

Runtime::~Runtime()
{
    try {
        shutdown();
        orb_->destroy();
    } catch (const ::CORBA::Exception& e) {
        reportError("sca::Runtime", e);
    }
}

::CORBA::ORB_ptr Runtime::orb() const
{
    return orb_.in();
}

::PortableServer::POA_ptr Runtime::poa() const
{
    return poa_.in();
}

::CF::Resource_ptr Runtime::activate(Resource& component, const std::string& identifier)
{
    component.setIdentifier(identifier);
    components_.push_back(&component);
    return component._this();
}

void Runtime::wait()
{
    std::signal(SIGINT, requestStop);
    std::signal(SIGTERM, requestStop);
    while (!stopRequested) {
        bool released = !components_.empty();
        for (std::size_t i = 0; i < components_.size(); ++i)
            if (!components_[i]->released()) released = false;
        if (released) break;
        omni_thread::sleep(0, 100 * 1000 * 1000);
    }
}

void Runtime::shutdown()
{
    if (down_) return;
    down_ = true;
    // Waits for the calls in progress, deactivates every object.
    orb_->shutdown(true);
}

void Runtime::serve(const std::vector<std::pair<Resource*, std::string> >& components, const ExecParams& params)
{
    // A Core Framework names the component of a process serving one.
    const bool one = components.size() == 1;
    for (std::size_t i = 0; i < params.others.size(); ++i)
        std::cerr << "execute parameter " << params.others[i].first << " ignored" << std::endl;
    std::vector< ::CF::Resource_var> refs;
    std::vector< ::CosNaming::Name> bindings;
    for (std::size_t i = 0; i < components.size(); ++i) {
        const std::string& name = components[i].second;
        refs.push_back(activate(*components[i].first, one && !params.identifier.empty() ? params.identifier : name));
        ::CosNaming::Name binding;
        binding.length(1);
        binding[0].id = (one && !params.nameBinding.empty() ? params.nameBinding : name).c_str();
        bindings.push_back(binding);
    }
    ::CosNaming::NamingContext_var context;
    std::size_t bound = 0;
    if (!params.namingContextIor.empty()) {
        ::CORBA::Object_var object = orb_->string_to_object(params.namingContextIor.c_str());
        context = ::CosNaming::NamingContext::_narrow(object);
        for (; bound < refs.size(); ++bound) context->rebind(bindings[bound], refs[bound].in());
    } else {
        try {
            ::CORBA::Object_var object = orb_->resolve_initial_references("NameService");
            context = ::CosNaming::NamingContext::_narrow(object);
            if (!::CORBA::is_nil(context))
                for (; bound < refs.size(); ++bound) context->rebind(bindings[bound], refs[bound].in());
        } catch (const ::CORBA::ORB::InvalidName&) {
            // No naming service configured (omniORB: NO_RESOURCES).
        } catch (const ::CORBA::NO_RESOURCES&) {
        } catch (const ::CORBA::SystemException& e) {
            reportError("NameService", e);
        }
        if (bound < refs.size()) {
            for (std::size_t i = 0; i < refs.size(); ++i) {
                ::CORBA::String_var ior = orb_->object_to_string(refs[i].in());
                std::cout << components[i].second << " " << ior.in() << std::endl;
            }
        }
    }
    wait();
    for (std::size_t i = 0; i < bound; ++i) {
        try {
            context->unbind(bindings[i]);
        } catch (const ::CORBA::Exception& e) {
            reportError(components[i].second.c_str(), e);
        }
    }
}

