namespace sca {

namespace {

volatile std::sig_atomic_t stopRequested = 0;

extern "C" void requestStop(int)
{
    stopRequested = 1;
}

void append(::CF::Properties& list, const ::CF::DataType& property)
{
    const ::CORBA::ULong n = list.length();
    list.length(n + 1);
    list[n] = property;
}

} // namespace

// Resource

Resource::Resource() : started_(false), released_(false) {}

Resource::~Resource() {}

void Resource::setIdentifier(const std::string& identifier)
{
    omni_mutex_lock lock(mutex_);
    identifier_ = identifier;
}

bool Resource::started() const
{
    omni_mutex_lock lock(mutex_);
    return started_;
}

bool Resource::released() const
{
    omni_mutex_lock lock(mutex_);
    return released_;
}

char* Resource::identifier()
{
    omni_mutex_lock lock(mutex_);
    return ::CORBA::string_dup(identifier_.c_str());
}

void Resource::start()
{
    onStart();
    omni_mutex_lock lock(mutex_);
    started_ = true;
}

void Resource::stop()
{
    onStop();
    omni_mutex_lock lock(mutex_);
    started_ = false;
}

void Resource::initialize()
{
    onInitialize();
}

void Resource::releaseObject()
{
    onRelease();
    omni_mutex_lock lock(mutex_);
    released_ = true;
}

void Resource::runTest(::CORBA::ULong, ::CF::Properties&)
{
    throw ::CF::TestableObject::UnknownTest();
}

void Resource::configure(const ::CF::Properties& configProperties)
{
    ::CF::Properties invalid;
    for (::CORBA::ULong i = 0; i < configProperties.length(); ++i) {
        const std::string id(configProperties[i].id.in());
        if (configureProperty(id, configProperties[i].value))
            onConfigured(id);
        else
            append(invalid, configProperties[i]);
    }
    if (invalid.length() == 0) return;
    if (invalid.length() == configProperties.length())
        throw ::CF::PropertySet::InvalidConfiguration("no property configured", invalid);
    throw ::CF::PropertySet::PartialConfiguration(invalid);
}

void Resource::query(::CF::Properties& configProperties)
{
    if (configProperties.length() == 0) {
        std::vector<std::string> ids;
        propertyIds(ids);
        configProperties.length(static_cast< ::CORBA::ULong>(ids.size()));
        for (::CORBA::ULong i = 0; i < configProperties.length(); ++i) {
            configProperties[i].id = ids[i].c_str();
            queryProperty(ids[i], configProperties[i].value);
        }
        return;
    }
    ::CF::Properties unknown;
    for (::CORBA::ULong i = 0; i < configProperties.length(); ++i)
        if (!queryProperty(configProperties[i].id.in(), configProperties[i].value))
            append(unknown, configProperties[i]);
    if (unknown.length() > 0) throw ::CF::UnknownProperties(unknown);
}

::CORBA::Object_ptr Resource::getPort(const char* name)
{
    ::CORBA::Object_ptr p = port(name);
    if (::CORBA::is_nil(p)) throw ::CF::PortSupplier::UnknownPort();
    return p;
}

