{%- comment -%}
  C++ type of an `in` parameter: `T` for basic types and enums, `const char*` for strings, else
  `const T&`. Parameters: t, owner.
{%- endcomment -%}
{%- liquid
  capture kind
    render '_cx_kind', t: t
  endcapture
  capture name
    render '_cx_name', t: t, owner: owner
  endcapture
  case kind
  when 'basic', 'enum'
    echo name
  when 'string'
    echo 'const char*'
  else
    echo 'const ' | append: name | append: '&'
  endcase
-%}
