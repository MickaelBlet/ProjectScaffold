namespace robot::core {

class Controller {
public:
    Controller();
    ~Controller();
    Controller(const Controller&) = delete;
    Controller& operator=(const Controller&) = delete;

    /// in port telemetry: Telemetry
    ::common::ITelemetry& telemetry() { return telemetryIn_; }

    ::common::Mode mode() const { return mode_; }

    /// Switch mode, false when the transition is not allowed
    bool setMode(const ::common::Mode mode);

    void reset();

    bool isRunning() const;

    /// Number of controllers alive
    static std::uint32_t instances();

    // <user:public>
    // </user:public>

protected:
    // Calls received by in port telemetry.
    void onTelemetryPublish(const ::common::Pose& pose, const std::map<std::string, std::list<std::uint8_t>>& tags);
    // <user:protected>
    // </user:protected>

private:
    class TelemetryIn final : public ::common::ITelemetry {
    public:
        explicit TelemetryIn(Controller& owner) : owner_(owner) {}
        void publish(const ::common::Pose& pose, const std::map<std::string, std::list<std::uint8_t>>& tags) override
        {
            return owner_.onTelemetryPublish(pose, tags);
        }

    private:
        Controller& owner_;
    };
    TelemetryIn telemetryIn_{*this};
    ::common::Mode mode_ = ::common::Mode::Idle;
    // <user:private>
    // </user:private>
};

} // namespace robot::core
"
